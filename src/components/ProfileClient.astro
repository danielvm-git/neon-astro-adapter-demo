---
export interface Props {
  authUrl: string;
}

const { authUrl } = Astro.props;
---

<div id="profile-content">
  <p>Loading...</p>
</div>

<script is:inline define:vars={{ authUrl }}>
  window.__NEON_AUTH_URL__ = authUrl;
</script>

<script>
  import { createAuthClient } from "@danielvm/neon-astro-auth";
  import { renderProfileContent } from "../lib/profile-renderer";

  function setNotLoggedIn(container: HTMLElement): void {
    const p = document.createElement("p");
    p.textContent = "Not logged in";
    container.replaceChildren(p);
  }

  (async () => {
    try {
      const authUrl: string = (window as unknown as Record<string, string>).__NEON_AUTH_URL__;
      const container = document.getElementById("profile-content");
      if (!authUrl) {
        if (container) setNotLoggedIn(container);
        return;
      }
      const client = createAuthClient(authUrl);
      const result: { data: { user?: { email?: string } } | null } =
        (await client.getSession()) as unknown as { data: { user?: { email?: string } } | null };

      if (container) {
        if (result.data?.user?.email) {
          renderProfileContent(container, result.data.user.email);
          document.getElementById("sign-out-btn")?.addEventListener("click", async () => {
            await client.signOut();
            window.location.href = "/";
          });
        } else {
          setNotLoggedIn(container);
        }
      }
    } catch {
      const container = document.getElementById("profile-content");
      if (container) setNotLoggedIn(container);
    }
  })();
</script>
